db = db.getSiblingDB("food_delivery");

// Find the most recent GPS location for each driver
db.driver_locations.aggregate([
    {
        $sort: {
            driver_account_id: 1,
            location_time: -1,
            _id: -1
        }
    },
    {
        $group: {
            _id: "$driver_account_id",
            last: { $first: "$$ROOT" }
        }
    }
]).forEach(({ _id, last }) => {

    // Update only drivers who consented to location sharing
    db.drivers.updateOne(
        {
            _id: _id,
            location_sharing_consent: true
        },
        {
            $set: {
                last_location: {
                    point: last.location,
                    recorded_at: last.location_time
                }
            }
        }
    );
});

print(
    "Drivers with last_location: " +
    db.drivers.countDocuments({
        last_location: { $type: "object" }
    })
);